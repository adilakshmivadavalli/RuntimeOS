agenthub/agents/youtube/db

# Archive files and large assets
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# Build caches
.cache/

memory/test_credentials.md

# Mobile development
android-sdk/
.env
.env.*
*.env

# ...except the templates above — these are safe to commit (no secrets,
# that's the whole point of a .env.example) and .env.* above was
# unintentionally catching them too, which meant `git clone` gave you no
# template to copy from.
!.env.example
!**/.env.example
credentials.json
*.key
.credentials
frontend/node_modules/.cache/default-development/0.pack

# Local Netlify folder
.netlify
